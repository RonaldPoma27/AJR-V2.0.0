# =========================================================================
# AJR Data — variables de entorno
#   Docker Compose:  cp .env.example .env
#   Backend sin Docker: cp .env.example backend/.env
#   Render: cargalas en Environment (no subas el .env al repo)
# Las líneas vacías o comentadas se consideran "no definidas".
# =========================================================================

# --- Obligatorias -----------------------------------------------------------
# Generá una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (mínimo 32 caracteres; en producción no acepta este valor de ejemplo)
SECRET_KEY=cambiame-por-un-valor-largo-y-aleatorio-generado-con-secrets

# Sin Docker (en compose se ignora y se arma sola con POSTGRES_*).
# En Neon/Render usá la URL que te dan; si trae ?sslmode=require, dejala.
# DATABASE_URL=postgresql+asyncpg://ajr:ajr@localhost:5432/ajrdata

# Solo para docker compose
POSTGRES_USER=ajr
POSTGRES_PASSWORD=ajr
POSTGRES_DB=ajrdata

# development | production  (en production Turnstile pasa a ser obligatorio)
ENVIRONMENT=development

# --- Admin inicial ----------------------------------------------------------
# Se crea automáticamente al arrancar (prestart.sh). Si falta alguna, se saltea.
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=una-clave-larga-y-unica     # 8 a 72 caracteres
# ADMIN_FULL_NAME=Nombre Apellido

# --- Cloudflare Turnstile (anti-bots) ---------------------------------------
# Claves de prueba (siempre aprueban):
#   sitekey 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=
# La sitekey se usa al COMPILAR el frontend (build arg en Docker):
# VITE_TURNSTILE_SITE_KEY=

# --- Mails (SMTP) -----------------------------------------------------------
# Sin SMTP_HOST no se manda nada (se loguea) y todo lo demás sigue funcionando.
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=hola@tudominio.com
# SMTP_TLS=starttls            # starttls | ssl | none
# ADMIN_NOTIFY_EMAIL=          # a dónde llegan los avisos (default: ADMIN_EMAIL)

# --- Mails: transporte y links ------------------------------------------------
# EMAIL_BACKEND=smtp           # smtp (default) | console (mock: loguea el mail, no manda nada)
# PUBLIC_BASE_URL=https://tudominio.com   # para el link "Mis pedidos" dentro de los mails

# --- Papelera y tareas periódicas ---------------------------------------------
# TRASH_RETENTION_DAYS=30           # días en la papelera antes de eliminar definitivamente
# TRASH_PURGE_INTERVAL_MINUTES=60   # cada cuánto corre la limpieza (APScheduler)
# SCHEDULER_ENABLED=true            # false = no iniciar tareas periódicas

# --- Protección por IP (todas opcionales; valores por defecto entre paréntesis) ----
# IP_GUARD_ENABLED=true           # false = apaga bloqueo y baneo
# IP_GUARD_TRUSTED_IPS=           # IPs exentas, separadas por coma (p. ej. tu IP fija)
# LOGIN_MAX_FAILURES=5            # contraseñas incorrectas seguidas hasta bloquear la IP
# LOGIN_LOCK_MINUTES=30           # duración del bloqueo de login/registro
# FLOOD_MAX_REQUESTS=60           # pedidos a /api en la ventana => baneo de la IP
# FLOOD_WINDOW_SECONDS=60
# FLOOD_BAN_HOURS=12              # duración del baneo (bloquea toda la API)

# --- Otros (opcionales) -----------------------------------------------------
# RATE_LIMIT_PER_HOUR=5        # envíos de formularios por IP y por hora
# CORS_ORIGINS=http://localhost:5173   # solo dev, separadas por coma
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
